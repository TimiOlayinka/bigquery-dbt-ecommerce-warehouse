config {
  type: "table",
  schema: "rdl_grand_heritage",
  name: "orders_history",
  description: "GrandHeritage orders - full history with versioning",
  tags: ["rdl", "grand_heritage"]
}

WITH history AS (
    SELECT
        order_number AS order_id,
        profile_id AS customer_id,
        submitted_date AS order_timestamp,
        price_total AS total_amount,
        state AS status,
        payment_type AS payment_method,
        discount_amount, shipping_cost, item_count,
        promotion_code AS promo_code,
        shipping_method AS delivery_method,
        site_code AS fulfilment_centre,
        ingest_date,
        CAST(REPLACE(SPLIT(ingest_time, '+')[OFFSET(0)], 'T', ' ') AS TIMESTAMP) AS ingest_ts
    FROM ${ref({schema: "rdl_grand_heritage", name: "orders_stg"})}
),
versioned AS (
    SELECT *,
        ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY ingest_date DESC, ingest_ts DESC) AS row_version,
        COUNT(*) OVER (PARTITION BY order_id) AS version_count,
        TO_HEX(MD5(
            COALESCE(order_id, '') || '|' || COALESCE(customer_id, '') || '|' ||
            COALESCE(CAST(order_timestamp AS STRING), '') || '|' ||
            COALESCE(CAST(total_amount AS STRING), '') || '|' ||
            COALESCE(status, '') || '|' || COALESCE(payment_method, '') || '|' ||
            COALESCE(CAST(discount_amount AS STRING), '') || '|' ||
            COALESCE(CAST(shipping_cost AS STRING), '') || '|' ||
            COALESCE(CAST(item_count AS STRING), '') || '|' ||
            COALESCE(promo_code, '') || '|' || COALESCE(delivery_method, '') || '|' ||
            COALESCE(fulfilment_centre, '')
        )) AS record_hash
    FROM history
)
SELECT
    order_id, customer_id,
    CAST(order_timestamp AS TIMESTAMP) AS order_timestamp,
    total_amount, status, payment_method, discount_amount, shipping_cost,
    item_count, promo_code, delivery_method, fulfilment_centre,
    'GrandHeritage' AS brand,
    'oracle_commerce' AS source_system,
    ingest_date, ingest_ts, row_version,
    row_version = 1 AS is_latest,
    version_count, record_hash
FROM versioned
