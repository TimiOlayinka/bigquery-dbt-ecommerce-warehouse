config {
  type: "table",
  schema: "rdl_debenhams",
  name: "customers_history",
  description: "Debenhams customers - full history with versioning",
  tags: ["rdl", "debenhams"]
}

WITH history AS (
    SELECT
        profile_id AS customer_id,
        email_address AS email,
        first_name, last_name,
        phone_number AS phone, city, country,
        customer_segment,
        registration_date AS signup_date,
        gender,
        receive_email AS is_subscribed,
        ingest_date,
        CAST(REPLACE(SPLIT(ingest_time, '+')[OFFSET(0)], 'T', ' ') AS TIMESTAMP) AS ingest_ts
    FROM ${ref({schema: "rdl_debenhams", name: "customers_stg"})}
),
versioned AS (
    SELECT *,
        ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY ingest_date DESC, ingest_ts DESC) AS row_version,
        COUNT(*) OVER (PARTITION BY customer_id) AS version_count,
        TO_HEX(MD5(
            COALESCE(customer_id, '') || '|' || COALESCE(email, '') || '|' ||
            COALESCE(first_name, '') || '|' || COALESCE(last_name, '') || '|' ||
            COALESCE(phone, '') || '|' || COALESCE(city, '') || '|' ||
            COALESCE(country, '') || '|' || COALESCE(customer_segment, '') || '|' ||
            COALESCE(CAST(signup_date AS STRING), '') || '|' ||
            COALESCE(gender, '') || '|' || COALESCE(CAST(is_subscribed AS STRING), '')
        )) AS record_hash
    FROM history
)
SELECT
    customer_id, email, first_name, last_name, phone, city, country,
    customer_segment,
    CAST(signup_date AS DATE) AS registration_date,
    gender,
    CAST(is_subscribed AS BOOL) AS is_marketing_opted_in,
    'Debenhams' AS brand,
    'oracle_commerce' AS source_system,
    ingest_date, ingest_ts, row_version,
    row_version = 1 AS is_latest,
    version_count, record_hash
FROM versioned
