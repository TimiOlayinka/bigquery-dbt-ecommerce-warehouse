config {
  type: "table",
  schema: "odl",
  name: "dim_products",
  tags: ["odl", "dim"]
}

------------------------------------------------------------------------------------------------------------------------
-- odl.dim_products
-- Unified product dimension with calculated margin metrics
-- Consumes RDL full-history models filtered to is_latest (current state only)
------------------------------------------------------------------------------------------------------------------------
WITH all_products AS (
    SELECT * FROM ${ref({schema: "rdl_boohoo", name: "products_history"})}       WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_boohoo_man", name: "products_history"})}   WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_prettylittlething", name: "products_history"})}          WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_nastygal", name: "products_history"})}     WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_karen_millen", name: "products_history"})} WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_coast", name: "products_history"})}        WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_debenhams", name: "products_history"})}    WHERE is_latest
)
SELECT
    TO_HEX(MD5(product_id || '|' || brand)) AS product_sk,
    product_id                      AS product_nk,
    product_name,
    colour,
    category,
    subcategory,
    current_price,
    cost_price,
    rrp,
    CASE WHEN rrp > 0 THEN ROUND((1 - current_price / rrp) * 100, 1) ELSE 0 END AS discount_pct,
    ROUND(current_price - cost_price, 2) AS margin,
    CASE WHEN current_price > 0 THEN ROUND((current_price - cost_price) / current_price * 100, 1) ELSE 0 END AS margin_pct,
    material,
    season,
    is_active,
    stock_status,
    brand,
    source_system,
    ingest_date,
    CURRENT_TIMESTAMP() AS dwh_created_at
FROM all_products
