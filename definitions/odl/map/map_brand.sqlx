config {
  type: "table",
  schema: "odl",
  name: "map_brand",
  tags: ["odl", "map"]
}

------------------------------------------------------------------------------------------------------------------------
-- odl.map_brand
-- Brand reference mapping
------------------------------------------------------------------------------------------------------------------------
SELECT
    'VelvetLane'             AS brand,
    'omnia_commerce'       AS source_system,
    'Value'   AS brand_tier,
    'velvetlane.com'              AS website
UNION ALL SELECT
    'VelvetMens',
    'omnia_commerce',
    'Value',
    'velvetmens.com'
UNION ALL SELECT
    'TrendPulse',
    'salesforce_commerce',
    'Value',
    'trendpulse.com'
UNION ALL SELECT
    'RebelChic',
    'shopify',
    'Mid',
    'rebelchic.com'
UNION ALL SELECT
    'AtelierLuxe',
    'magento',
    'Premium',
    'atelierluxe.com'
UNION ALL SELECT
    'RivieraMode',
    'magento',
    'Premium',
    'rivieramode.com'
UNION ALL SELECT
    'GrandHeritage',
    'oracle_commerce',
    'Mid',
    'grandheritage.com'
