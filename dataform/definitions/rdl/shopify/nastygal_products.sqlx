config {
  type: "view",
  schema: "rdl",
  description: "NastyGal products - full history with versioning",
  tags: ["rdl", "shopify"]
}

WITH history AS (
    SELECT
        id AS product_id,
        title AS product_name,
        option1 AS colour,
        product_type AS category,
        tags AS subcategory,
        price AS current_price,
        cost_per_item AS cost_price,
        compare_at_price AS rrp,
        body_html AS material,
        vendor AS season,
        CASE WHEN status = 'active' THEN TRUE ELSE FALSE END AS is_active,
        stock_status, created_at, updated_at,
        ingest_date,
        CAST(REPLACE(SPLIT(ingest_time, '+')[OFFSET(0)], 'T', ' ') AS TIMESTAMP) AS ingest_ts
    FROM ${ref({schema: "rdl_raw", name: "nastygal_products_history"})}
),
versioned AS (
    SELECT *,
        ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY ingest_date DESC, ingest_ts DESC) AS row_version,
        COUNT(*) OVER (PARTITION BY product_id) AS version_count,
        TO_HEX(MD5(
            COALESCE(product_id, '') || '|' || COALESCE(product_name, '') || '|' ||
            COALESCE(colour, '') || '|' || COALESCE(category, '') || '|' ||
            COALESCE(subcategory, '') || '|' ||
            COALESCE(CAST(current_price AS STRING), '') || '|' ||
            COALESCE(CAST(cost_price AS STRING), '') || '|' ||
            COALESCE(CAST(rrp AS STRING), '') || '|' ||
            COALESCE(material, '') || '|' || COALESCE(season, '') || '|' ||
            COALESCE(CAST(is_active AS STRING), '') || '|' ||
            COALESCE(stock_status, '') || '|' ||
            COALESCE(CAST(created_at AS STRING), '') || '|' ||
            COALESCE(CAST(updated_at AS STRING), '')
        )) AS record_hash
    FROM history
)
SELECT
    product_id, product_name, colour, category, subcategory,
    current_price, cost_price, rrp, material, season,
    is_active, stock_status, created_at, updated_at,
    'NastyGal' AS brand,
    'shopify' AS source_system,
    ingest_date, ingest_ts, row_version,
    row_version = 1 AS is_latest,
    version_count, record_hash
FROM versioned
