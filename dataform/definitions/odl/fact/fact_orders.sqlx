config {
  type: "table",
  schema: "odl",
  name: "fact_orders",
  tags: ["odl", "fact"]
}

------------------------------------------------------------------------------------------------------------------------
-- odl.fact_orders
-- Unified order fact table with surrogate keys to dimensions
-- Consumes RDL full-history models filtered to is_latest (current state only)
------------------------------------------------------------------------------------------------------------------------
WITH all_orders AS (
    SELECT * FROM ${ref({schema: "rdl_boohoo", name: "orders_history"})}       WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_boohoo_man", name: "orders_history"})}   WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_prettylittlething", name: "orders_history"})}          WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_nastygal", name: "orders_history"})}     WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_karen_millen", name: "orders_history"})} WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_coast", name: "orders_history"})}        WHERE is_latest
    UNION ALL
    SELECT * FROM ${ref({schema: "rdl_debenhams", name: "orders_history"})}    WHERE is_latest
)
SELECT
    TO_HEX(MD5(order_id || '|' || brand))       AS order_sk,
    order_id                            AS order_nk,
    TO_HEX(MD5(customer_id || '|' || brand))    AS customer_sk,
    order_timestamp,
    CAST(order_timestamp AS DATE)               AS order_date,
    EXTRACT(YEAR FROM order_timestamp)  AS order_year,
    EXTRACT(MONTH FROM order_timestamp) AS order_month,
    EXTRACT(DAYOFWEEK FROM order_timestamp)   AS order_day_of_week,
    total_amount,
    discount_amount,
    shipping_cost,
    total_amount + shipping_cost                AS gross_revenue,
    total_amount - COALESCE(discount_amount, 0) AS net_revenue,
    status,
    payment_method,
    promo_code,
    delivery_method,
    fulfilment_centre,
    item_count,
    brand,
    source_system,
    ingest_date,
    CURRENT_TIMESTAMP() AS dwh_created_at
FROM all_orders
